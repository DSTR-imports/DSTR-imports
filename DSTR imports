<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BLACK SOLE | Sneakers</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #080808;
            color: #fff;
            font-family: Arial, Helvetica, sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* MENU */

        header {
            padding: 25px 7%;
            border-bottom: 1px solid #222;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            background: #080808;
            z-index: 100;
        }

        .logo {
            font-size: 25px;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .logo span {
            color: #777;
        }

        nav {
            display: flex;
            gap: 25px;
        }

        nav a {
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
        }

        nav a:hover {
            color: #999;
        }

        /* HERO */

        .hero {
            min-height: 650px;
            padding: 100px 7%;
            display: flex;
            align-items: center;

            background:
                radial-gradient(circle at 80% 40%, #333 0%, #111 25%, #080808 60%);
        }

        .hero-content {
            max-width: 800px;
        }

        .tag {
            display: inline-block;
            border: 1px solid #fff;
            padding: 10px 15px;
            font-size: 12px;
            letter-spacing: 3px;
            margin-bottom: 25px;
        }

        .hero h1 {
            font-size: clamp(55px, 10vw, 130px);
            line-height: .82;
            text-transform: uppercase;
            letter-spacing: -7px;
            font-weight: 900;
        }

        .hero p {
            margin-top: 30px;
            color: #aaa;
            max-width: 500px;
            line-height: 1.7;
        }

        .hero-button {
            display: inline-block;
            margin-top: 30px;
            padding: 16px 30px;
            background: #fff;
            color: #000;
            font-weight: 900;
            text-transform: uppercase;
        }

        .hero-button:hover {
            background: #ccc;
        }

        /* PRODUTOS */

        .produtos {
            padding: 90px 7%;
        }

        .titulo {
            margin-bottom: 40px;
        }

        .titulo small {
            color: #777;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .titulo h2 {
            font-size: 55px;
            margin-top: 10px;
            text-transform: uppercase;
            letter-spacing: -3px;
        }

        .linha {
            width: 100%;
            height: 1px;
            background: #222;
            margin-top: 20px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .produto {
            background: #111;
            border: 1px solid #222;
            transition: .3s;
        }

        .produto:hover {
            transform: translateY(-7px);
            border-color: #555;
        }

        .foto {
            height: 300px;
            background: #ddd;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .foto img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .sem-foto {
            color: #111;
            font-size: 18px;
            font-weight: bold;
        }

        .informacoes {
            padding: 22px;
        }

        .informacoes h3 {
            font-size: 21px;
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .preco-antigo {
            color: #777;
            text-decoration: line-through;
            font-size: 14px;
        }

        .desconto {
            color: #aaa;
            font-size: 13px;
            margin-top: 5px;
        }

        .preco {
            font-size: 32px;
            font-weight: 900;
            margin-top: 5px;
        }

        .comprar {
            display: block;
            background: #fff;
            color: #000;
            text-align: center;
            padding: 14px;
            margin-top: 20px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .comprar:hover {
            background: #ccc;
        }

        /* REDES SOCIAIS */

        .redes {
            background: #fff;
            color: #000;
            text-align: center;
            padding: 90px 7%;
        }

        .redes h2 {
            font-size: 50px;
            text-transform: uppercase;
            letter-spacing: -3px;
        }

        .redes p {
            color: #555;
            margin-top: 15px;
        }

        .botoes {
            margin-top: 35px;
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .instagram {
            background: #000;
            color: #fff;
            padding: 17px 25px;
            font-weight: bold;
        }

        .instagram:hover {
            background: #333;
        }

        /* FOOTER */

        footer {
            padding: 50px 7%;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            border-top: 1px solid #222;
        }

        footer p {
            color: #666;
            font-size: 13px;
        }

        /* WHATSAPP */

        .whatsapp {
            position: fixed;
            right: 25px;
            bottom: 25px;

            width: 60px;
            height: 60px;

            background: #25D366;
            color: #fff;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            font-weight: bold;
            font-size: 20px;

            z-index: 999;
        }

        /* CELULAR */

        @media (max-width: 800px) {

            header {
                padding: 20px;
            }

            nav {
                display: none;
            }

            .hero {
                padding: 80px 20px;
                min-height: 600px;
            }

            .hero h1 {
                letter-spacing: -4px;
            }

            .produtos {
                padding: 70px 20px;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .titulo h2 {
                font-size: 42px;
            }

            .redes {
                padding: 70px 20px;
            }

            .redes h2 {
                font-size: 40px;
            }

            footer {
                padding: 40px 20px;
            }
        }
    </style>
</head>

