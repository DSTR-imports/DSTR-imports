<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>BLACK SOLE — Sneakers</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #050505;
      color: #fff;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* HEADER */
    header {
      min-height: 90vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 30px 7%;
      background:
        linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.9)),
        url("https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1800&q=80")
        center/cover;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 30px;
      font-weight: 900;
      letter-spacing: -2px;
    }

    .logo span {
      color: #aaa;
    }

    .nav-links {
      display: flex;
      gap: 25px;
      font-size: 14px;
      font-weight: bold;
      text-transform: uppercase;
    }

    .nav-links a:hover {
      color: #aaa;
    }

    .hero {
      max-width: 750px;
      padding-bottom: 80px;
    }

    .tag {
      display: inline-block;
      border: 1px solid #fff;
      padding: 8px 15px;
      margin-bottom: 20px;
      font-size: 12px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .hero h1 {
      font-size: clamp(55px, 9vw, 120px);
      line-height: .85;
      text-transform: uppercase;
      font-weight: 900;
      letter-spacing: -7px;
    }

    .hero p {
      margin-top: 30px;
      color: #ccc;
      max-width: 500px;
      line-height: 1.6;
    }

    .button {
      display: inline-block;
      margin-top: 30px;
      background: #fff;
      color: #000;
      padding: 16px 28px;
      font-weight: 900;
      text-transform: uppercase;
      transition: .2s;
    }

    .button:hover {
      background: #ccc;
      transform: translateY(-3px);
    }

    /* PRODUTOS */

    .products-section {
      padding: 100px 7%;
    }

    .section-title {
      display: flex;
      justify-content: space-between;
      align-items: end;
      margin-bottom: 45px;
      border-bottom: 1px solid #333;
      padding-bottom: 20px;
    }

    .section-title h2 {
      font-size: 50px;
      text-transform: uppercase;
      letter-spacing: -3px;
    }

    .section-title span {
      color: #888;
      font-size: 13px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .product {
      background: #101010;
      border: 1px solid #222;
      position: relative;
      overflow: hidden;
      transition: .3s;
    }

    .product:hover {
      transform: translateY(-8px);
      border-color: #555;
    }

    .product-image {
      height: 330px;
      background: #eaeaea;
      overflow: hidden;
      position: relative;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: .4s;
    }

    .product:hover img {
      transform: scale(1.07);
    }

    .discount {
      position: absolute;
      top: 15px;
      left: 15px;
      background: #000;
      color: #fff;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: bold;
    }

    .product-info {
      padding: 22px;
    }

    .product-info h3 {
      font-size: 20px;
      text-transform: uppercase;
      margin-bottom: 15px;
    }

    .old-price {
      color: #777;
      text-decoration: line-through;
      font-size: 14px;
    }

    .price {
      font-size: 30px;
      font-weight: 900;
      margin-top: 5px;
    }

    .buy-button {
      display: block;
      margin-top: 20px;
      background: #fff;
      color: #000;
      padding: 14px;
      text-align: center;
      font-weight: bold;
      text-transform: uppercase;
    }

    .buy-button:hover {
      background: #ccc;
    }

    /* INSTAGRAM */

    .social-section {
      padding: 80px 7%;
      background: #fff;
      color: #000;
      text-align: center;
    }

    .social-section h2 {
      font-size: 50px;
      text-transform: uppercase;
      letter-spacing: -3px;
    }

    .social-section p {
      color: #555;
      margin-top: 10px;
    }

    .social-buttons {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 35px;
    }

    .social-button {
      background: #000;
      color: #fff;
      padding: 17px 30px;
      font-weight: bold;
      text-transform: uppercase;
    }

    .social-button:hover {
      background: #333;
    }

    /* FOOTER */

    footer {
      padding: 50px 7%;
      border-top: 1px solid #222;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
      flex-wrap: wrap;
    }

    footer p {
      color: #777;
      font-size: 13px;
    }

    .whatsapp {
      position: fixed;
      right: 25px;
      bottom: 25px;
      width: 60px;
      height: 60px;
      background: #25D366;
      color: white;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 25px;
      font-weight: bold;
      box-shadow: 0 5px 20px rgba(0,0,0,.4);
      z-index: 999;
    }

    /* CELULAR */

    @media (max-width: 900px) {

      .nav-links {
        display: none;
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
      }

      .hero h1 {
        letter-spacing: -4px;
      }
    }

    @media (max-width: 600px) {

      header {
        min-height: 80vh;
      }

      .products-section {
        padding: 70px 5%;
      }

      .products {
        grid-template-columns: 1fr;
      }

      .section-title {
        display: block;
      }

      .section-title h2 {
        font-size: 40px;
      }

      .product-image {
        height: 300px;
      }

      .social-section h2 {
        font-size: 40px;
      }
    }
  </style>
</head>

